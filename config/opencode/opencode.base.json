{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-local/llama3.2:3b",
  "small_model": "ollama-local/llama3.2:3b",
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://ollama-local:11434/v1" },
      "models": {}
    },
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://ollama.com/v1", "apiKey": "{env:OLLAMA_API_KEY}" },
      "models": {}
    },
    "weave": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://weave.redpencil.io/v1", "apiKey": "{env:WEAVE_API_KEY}" },
      "models": {}
    },
    "llama-prism": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://llama-prism:8080/v1" },
      "models": {}
    }
  },
  "permission": {
    "read": "allow",
    "edit": { "/workspace/**": "allow" },
    "bash": "allow",
    "external_directory": { "/workspace/**": "allow", "*": "deny" }
  }
}
